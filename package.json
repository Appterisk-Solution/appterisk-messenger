{
  "name": "appterisk-messenger",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "cargo": "node scripts/cargo.mjs",
    "test:isolation": "node scripts/tauri.mjs build --debug --no-bundle && node scripts/isolation.mjs",
    "test:edge": "node scripts/edge-comparison.mjs",
    "build:controls": "node scripts/cargo.mjs build --manifest-path diagnostics/Cargo.toml --release -p appterisk-native-control -p appterisk-minimal-tauri-control",
    "test:native": "node scripts/control-run.mjs native",
    "test:tauri": "node scripts/control-run.mjs tauri",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:manager": "node scripts/tauri.mjs build --debug --no-bundle && node scripts/manager-tests.mjs",
    "dev:diagnostics": "node scripts/tauri.mjs dev -- --diagnostics",
    "test:upgrade": "node scripts/upgrade-test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.16",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.5"
  }
}
