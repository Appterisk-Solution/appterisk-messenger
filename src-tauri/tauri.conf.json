{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Appterisk Messenger",
  "version": "0.5.4",
  "identifier": "com.appterisk.messenger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Appterisk Messenger",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNDg4MEI2QzhGRkYxNTQKUldSVThmL0l0b0JJVGpvampET0tYT3Z6NFMyN05BaFJsS1VNNW1oUjF1U2dLdDJkR29ia2pkVmcK",
      "endpoints": [
        "https://raw.githubusercontent.com/Appterisk-Solution/appterisk-messenger/update-channels/stable/update.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
